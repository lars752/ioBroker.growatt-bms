{
  "common": {
    "name": "growatt-bms",
    "version": "1.0.2",
    "news": {
      "1.0.2": {
        "en": "pruneOnStart: old flat data points are deleted automatically on adapter start",
        "de": "pruneOnStart: veraltete flache Datenpunkte werden beim Adapterstart automatisch gelöscht"
      },
      "1.0.1": {
        "en": "BMS data points moved into 'bms' subfolder; Cells remain under Cells.*",
        "de": "BMS-Datenpunkte in Unterordner 'bms' verschoben; Zellspannungen bleiben unter Cells.*"
      },
      "1.0.0": {
        "en": "Initial release",
        "de": "Erstveröffentlichung"
      }
    },
    "titleLang": {
      "en": "Growatt BMS (CAN bus)",
      "de": "Growatt BMS (CAN-Bus)"
    },
    "desc": {
      "en": "Reads a Growatt low-voltage BMS from the CAN bus and provides voltage, current, SoC, limits, cell voltages and alarms",
      "de": "Liest ein Growatt-Niedervolt-BMS vom CAN-Bus und stellt Spannung, Strom, SoC, Limits, Zellspannungen und Alarme bereit"
    },
    "authors": [
      "Lars"
    ],
    "keywords": [
      "growatt",
      "bms",
      "can",
      "battery"
    ],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "main": "main.js",
    "icon": "growatt-bms.png",
    "enabled": true,
    "extIcon": "https://raw.githubusercontent.com/lars752/ioBroker.growatt-bms/main/admin/growatt-bms.png",
    "readme": "https://github.com/lars752/ioBroker.growatt-bms/blob/main/README.md",
    "loglevel": "info",
    "mode": "daemon",
    "type": "hardware",
    "compact": false,
    "connectionType": "local",
    "dataSource": "push",
    "adminUI": {
      "config": "json"
    },
    "dependencies": [
      {
        "js-controller": ">=5.0.19"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=6.0.0"
      }
    ]
  },
  "native": {
    "source": "socketcan",
    "canInterface": "can0",
    "candumpPath": "candump",
    "canAdapterInstance": "canbus.0",
    "timeoutSec": 15,
    "watchdogSec": 5,
    "throttleSec": 5,
    "failSafeZero": true,
    "plausibility": true
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": "BMS sendet Daten",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    }
  ]
}